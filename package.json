{
  "name": "kassbi-leekwars-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test --test-reporter=dot tests/*.test.mjs",
    "posttest": "node scripts/tests-state.mjs ok",
    "test:only": "npm run build && node --test --test-reporter=dot",
    "posttest:only": "node scripts/tests-state.mjs ok",
    "agents:sync": "node scripts/sync-agents.mjs",
    "docs:check": "node scripts/check-doc-budget.mjs",
    "hooks:install": "git config core.hooksPath .githooks && git config commit.template .gitmessage"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
