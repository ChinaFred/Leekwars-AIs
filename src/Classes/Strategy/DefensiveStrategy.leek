// @version:4
// file version: 2
include("/Classes/Strategy/LeekStrategy")

class DefensiveStrategy extends LeekStrategy {
	constructor() {
		super("DEFENSIVE", 50)
	}

	constructor(integer aggressionValue) {
		super("DEFENSIVE", aggressionValue)
	}

	real scoreWeapon(real damage, integer preferredMid, integer weaponMid) {
		real rangePenalty = abs(preferredMid - weaponMid) * (0.07 - 0.015 * getAggressionRatio())
		return damage - rangePenalty
	}

	boolean shouldHeal(real lifeRatio, real lostLifeRatio) {
		return lifeRatio <= 0.90 - 0.15 * getAggressionRatio() or lostLifeRatio >= 0.35
	}

	boolean shouldShield(real lifeRatio, integer distance, integer threatRange) {
		return distance <= threatRange + 1 and lifeRatio <= 0.98 - 0.10 * getAggressionRatio()
	}

	boolean shouldHide(real lifeRatio, integer mpLeft) {
		return mpLeft > 0 and lifeRatio <= 0.80 - 0.10 * getAggressionRatio()
	}

	boolean shouldUseAttackChip(real lifeRatio) {
		return lifeRatio >= 0.75 - 0.20 * getAggressionRatio()
	}
}
