include("/Classes/Leek")
include("/Classes/Items/Weapon")
include("/Classes/Context/World")
include("/Classes/Context/DangerMap")
include("/Classes/Plannification/Action")
include("/Toolbox/Constants")
include("/Classes/Plannification/ShootingOption")
include("/Classes/Plannification/ShootingOptions")
include("/Classes/Strategy/LeekStrategy")
include("/Classes/Strategy/AggressiveStrategy")
include("/Classes/Strategy/BalancedStrategy")
include("/Classes/Strategy/DefensiveStrategy")

/**
 * Classe Plannification qui g�re la planification des actions d'un poireau dans le jeu.
 */
class Plannification {
	public Leek | null leek = null
	public Array < Action > actions = []
	public integer tpLeft = 0
	public integer mpLeft = 0
	public Coordinates cellToShootFrom = new Coordinates()
	public Weapon | null chosenWeapon = null
	public boolean willShoot = false
	public boolean weaponEquipPlanned = false
	public LeekStrategy strategy = new LeekStrategy()
	
	public Array<ShootingOption> shootingOptions = [] 

	/**
	 * Constructeur de la classe Plannification.
	 *
	 * @param l - Le poireau pour lequel la planification est effectu�e.
	 */
	constructor(Leek l) {
		leek = l
		tpLeft = leek.tp
		mpLeft = leek.mp
		actions = []
		cellToShootFrom = new Coordinates()
		willShoot = false
		if (leek.profile.strategyName == "AGGRESSIVE")
			strategy = new AggressiveStrategy(leek.profile.aggression)
		else if (leek.profile.strategyName == "DEFENSIVE")
			strategy = new DefensiveStrategy(leek.profile.aggression)
		else
			strategy = new BalancedStrategy(leek.profile.aggression)
	}

	/**
	 * Choisis une arme pour le poireau.
	 */
	void chooseWeapon() {
		Weapon | null bestWeapon = null
		real bestDamage = 0.
		for (Weapon w in leek.wearedWeapons){
			integer preferredMid = (leek.profile.preferredMinRange + leek.profile.preferredMaxRange) / 2
			integer weaponMid = (w.range[0] + w.range[1]) / 2
			real score = strategy.scoreWeapon(w.getTurnDamage(tpLeft), preferredMid, weaponMid)
			if (bestWeapon == null or bestDamage < score) {
				bestWeapon = w
				bestDamage = score
			}
		}

		chosenWeapon = bestWeapon
	}

	void planChipsActions() {
		if (leek.totalLife <= 0)
			return
		Array < Chip > cooledChips = leek.cooledChips
		Array < Chip > healChips  = Chip.getHealingChips(cooledChips)
		Array < Chip > shieldChips  = Chip.getShieldChips(cooledChips)
	
		
		/// Heal if wounded
		integer lostLife = leek.totalLife - leek.life
		real lifeRatio = leek.life / leek.totalLife
		real lostLifeRatio = lostLife / leek.totalLife
		if(leek.profile.allowHealing and strategy.shouldHeal(lifeRatio, lostLifeRatio)) {
			boolean healingPlanned = false
			for (Chip hc in healChips){
				if (!healingPlanned and hc.meanHeal <= lostLife and leek.canUseChipOnTarget(hc, leek, tpLeft)){
					push(actions, new Action("heal  ", function() {
							leek.useChip(hc, leek)
						},
						hc.name))
					tpLeft = tpLeft - hc.cost
					healingPlanned = true
				
				}
			}
		}
			
		Leek? actionTarget = leek.target
		Weapon? threatWeapon = leek.equipedWeapon
		if (threatWeapon == null)
			threatWeapon = chosenWeapon
		if (actionTarget != null) {
			if (threatWeapon != null) {
				integer distance = getCellDistance(leek.coordinates.cell, actionTarget.coordinates.cell)
				debug("shield ? distance " + distance)
				debug("target.mp " + actionTarget.mp)
				if (leek.profile.allowShielding and threatWeapon.range != []
					and strategy.shouldShield(lifeRatio, distance, actionTarget.mp + threatWeapon.range[1])) {
					debug("i willl choose an helmet")
					boolean shieldingPlanned = false
					for (Chip sc in shieldChips) {
						if (!shieldingPlanned and leek.canUseChipOnTarget(sc, leek, tpLeft)) {
							push(actions, new Action("Shield  ", function() {
									leek.useChip(sc, leek)
								},
								sc.name))
							tpLeft = tpLeft - sc.cost
							shieldingPlanned = true
						}
					}
				}
				else {
					debug("no helmet")
				}
			}
		}
	}


	/**
	 * Planifie l'�quipement d'une arme par le poireau.
	 */
	void planEquipWeapon() {
		if (leek.target == null)
			return
		if(chosenWeapon == null)
			chooseWeapon() //faire un choix �clair�$
		if (chosenWeapon == null)
			return
		Weapon? weaponToEquip = chosenWeapon
		if (weaponToEquip == null)
			return
		boolean needsEquip = true
		if (leek.equipedWeapon != null)
			needsEquip = leek.equipedWeapon.id != weaponToEquip.id
		if (needsEquip and tpLeft >= 1) {
			push(actions, new Action("equip weapon ", function() {
					leek.equipWeapon(weaponToEquip)
				},
				weaponToEquip.name))
			tpLeft = tpLeft - 1
			weaponEquipPlanned = true
		} else if (needsEquip) {
			debug("Not enough TP to equip " + weaponToEquip.name)
		}
	}

	/**
	 * Planifie le d�placement du poireau.
	 */
	void planMove() {
		Leek? actionTarget = leek.target
		if (actionTarget == null)
			return
		Weapon? weaponToUse = chosenWeapon
		if (weaponToUse == null)
			chooseWeapon()
		weaponToUse = chosenWeapon
		if (weaponToUse == null)
			return
		Set < integer > cellsToShootFrom = weaponToUse.fromWhereToUse(actionTarget, leek.reachableCells)
		if(DEBUGS.MARK_CELLS_TO_SHOOT_FROM)
			mark(setToArray(cellsToShootFrom), COLORS.SALMON)
		integer distance = 70
		if (cellsToShootFrom == < > ) {
			// move towards target full speed
			while (mpLeft > 0) {
				push(actions, new Action("move toward ", function() {
					leek.moveTowardTarget()
				}, "Move towards enemy"))
				mpLeft = mpLeft - 1
				// insérer possibilité d'utiliser une puce pour tirer sur l'ennemi si distance and Los
			}
		} else {
			if (cellsToShootFrom != < > ) {
				Map < integer, integer > cellsDistanceToLeek = new Map()
				for (integer c in cellsToShootFrom) {
					integer pathLength = getPathLength(leek.cell, c)
					if (pathLength <= leek.mp){
						
						mapPut(cellsDistanceToLeek, c, pathLength)
					}
					
					else {
						debugC("erreur dans le calcul de cells to shoot from leek.cell " + leek.cell + " c " + c , COLOR_RED)
					}
				}
				distance = mapMin(cellsDistanceToLeek)
				cellToShootFrom = world.getCoordinatesFromCell(mapSearch(cellsDistanceToLeek, distance))
				willShoot = (getPathLength(cellToShootFrom.cell, leek.cell) <= leek.mp)
				mark(cellToShootFrom.cell, COLORS.WARNING)
			} else {
				cellToShootFrom = world.getCoordinatesFromCell(actionTarget.cell)
				distance = getPathLength(leek.cell, cellToShootFrom.cell)
				mark(cellToShootFrom.cell, COLORS.BROWN)
				debugC("pourquoi a t on ce cas ?", COLOR_RED)
			}

			push(actions, new Action("moveTowardOneCell " + cellToShootFrom, function() {
				leek.moveTowardOneCell(cellToShootFrom.cell)
			}, "cell to shoot from " + cellToShootFrom))

			mpLeft = mpLeft - distance
		}
	}

	/**
	 * Planifie le tir du poireau.
	 */
	void planShoot() {
		Weapon? weaponToUse = chosenWeapon
		if (leek.target == null or !willShoot or !weaponIsReadyForPlan())
			return
		if (weaponToUse == null)
			return
		if (weaponToUse.cost <= 0)
			return
		while (tpLeft >= weaponToUse.cost) {
			debug("planshoot + tpleft " + tpLeft)
			push(actions, new Action("shoot", function() {
					leek.shoot()
				},
				"planshoot + tpleft after" + tpLeft))
			tpLeft = tpLeft - weaponToUse.cost
		}
		debug("planshoot + tpleft after" + tpLeft)
	}

	/**
	 * Planifie le tir ou l'utlisation d'un chip du poireau.
	 */
	void planShootOrChip() {
		if (leek.totalLife <= 0)
			return
		real lifeRatio = leek.life / leek.totalLife
		Chip? chipIce = leek.getChipById(CHIP_ICE)
		Leek? actionTarget = leek.target
		if (actionTarget == null)
			return
		if (chipIce != null and strategy.shouldUseAttackChip(lifeRatio)
			and leek.canUseChipOnTarget(chipIce, actionTarget, tpLeft)) {
				push(actions, 
				 new Action("ice this one", 
					function() {
						leek.useChip(chipIce, actionTarget)
					}, "on " + actionTarget.name)
				)
				tpLeft = tpLeft-chipIce.cost
			}

			Weapon? weaponToUse = chosenWeapon
			if (willShoot and weaponIsReadyForPlan()) {
				if (weaponToUse != null) {
					if (weaponToUse.cost > 0) {
						while (tpLeft >= weaponToUse.cost) {
							debug("planShootOrChip + tpleft " + tpLeft)
							push(actions, new Action("shoot", function() {
									leek.shoot()
								},
								"planShootOrChip + tpleft after" + tpLeft))
							tpLeft = tpLeft - weaponToUse.cost
						}
					}
				}
			}
		}

	boolean weaponIsReadyForPlan() {
		Weapon? plannedWeapon = chosenWeapon
		if (plannedWeapon == null)
			return false
		if (weaponEquipPlanned)
			return true
		Weapon? equippedWeapon = leek.equipedWeapon
		if (equippedWeapon == null)
			return false
		return equippedWeapon.id == plannedWeapon.id
	}

		/**
		 * Planifie la dissimulation du poireau.
		 */
		void planHide() {
			Leek? actionTarget = leek.target
			DangerMap? dangerMap = leek.dangerMap
			if (actionTarget == null)
				return
			if (dangerMap == null)
				return
			if (leek.totalLife <= 0)
				return
			real lifeRatio = leek.life / leek.totalLife
			if (leek.profile.allowHiding and strategy.shouldHide(lifeRatio, mpLeft)) {
				Coordinates safeCell = dangerMap.getPlaceToHide(leek, actionTarget, cellToShootFrom, mpLeft)
				debugC("place to hide " + safeCell, COLOR_RED)
				if (safeCell.cell > -1) {
					push(actions, new Action("hide", function() {
						leek.moveTowardOneCell(safeCell.cell)
					}, "safe place : " + safeCell))

				}

			}

		}

	void chooseAgressionTactic(){
		Array<Item> potentialAttacks = ShootingOption.buildDamagingItemsTable(leek)
		ShootingOptions shootingOptions = new ShootingOptions()
		ShootingOption shootingOption = new ShootingOption(leek)
		
	
	}






		/**
		 * Ex�cute les actions planifi�es.
		 */
		void execute() {
			debug("Actions" + actions)
			while (count(actions) > 0) {
				Action toExecute = shift(actions)
				debug("play " + toExecute.name + " - " + toExecute.desc)
				toExecute.action()

			}

		}

	}