include("/Classes/Leek")
include("/Brain/PlanActScenario")
include("/Classes/Context/World")

global World world = new World()
LeekProfile kassbiProfile = new LeekProfile()
kassbiProfile.setRole("BALANCED")
kassbiProfile.setAggression(50)
kassbiProfile.setPreferredRange(3, 8)
kassbiProfile.setSupportOptions(true, true, true)
global Leek kassbi = new Leek(getEntity(), planAct, kassbiProfile)

var turn = getTurn()
world.updateData()
if (turn > 1) {
	kassbi.updateData()
	kassbi.updateDataMyLeeks()
}

kassbi.play()