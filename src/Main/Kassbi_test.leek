// @version:4
// file version: 1
include("/Classes/Leek")
include("/Brain/simpleActionSequence")
include("/Brain/PlanActScenario")
include("/Classes/Context/World")
	global World world = new World()
	LeekProfile kassbiProfile = new LeekProfile()
	kassbiProfile.setRole("AGGRESSIVE")
	kassbiProfile.setAggression(75)
	kassbiProfile.setPreferredRange(2, 8)
	kassbiProfile.setSupportOptions(true, true, false)
	global kassbi = new Leek(getEntity(), planAct, kassbiProfile)

	// init
	world.buildObstaclesCoordinatesSet()
	world.setEnemiesLeeks()

	var turn = getTurn()
	if (turn > 1)
	{
		kassbi.updateData()
		world.updateData()
		// doit venir après le monde pour permettre l'update de la danger map'
		kassbi.updateDataMyLeeks()
	}
	
	// call AI 
	kassbi.play()

