// @version:4
// file version: 2
include ("/Toolbox/Debug")

function simpleActionSequence(me) {
	debug_BeginTurn ()
	me.setTarget(getNearestEnemy())

	if (me.target != null) {
		if (me.equipedWeapon == null)
			me.equipWeaponById(WEAPON_PISTOL)

		if (me.equipedWeapon != null) {
			while (me.mp > 0 and me.tp >= me.equipedWeapon.cost and !me.canShootOnTarget())
				me.moveTowardTarget()
			while (me.canShootOnTarget())
				me.shoot()
			me.fleeTarget()
		} else {
			debug("No equipped weapon is available")
		}
	}
	debug_EndTurn ()
}